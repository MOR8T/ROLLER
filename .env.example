# Docker Compose environment — copy to `.env` (gitignored) and fill in real
# values before `docker compose up`. This is separate from `backend/.env`,
# which is only used when running `uvicorn` directly on the host (its
# DATABASE_URL points at `localhost`; this one's DATABASE_URL is composed in
# docker-compose.yml from the POSTGRES_* values below and points at the `db`
# service instead).

# --- Postgres ---
POSTGRES_USER=example_bd
POSTGRES_PASSWORD=example_password
POSTGRES_DB=roller_bd

# --- Backend (FastAPI) ---
SECRET_KEY=dev_secret_key_super_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Initial admin seed ---
# Seeded once at backend startup if a user with this username doesn't already
# exist (there is no /register endpoint). Change the password before any real
# deployment.
INITIAL_ADMIN_USERNAME=example_admin
INITIAL_ADMIN_EMAIL=example_admin@roller.tj
INITIAL_ADMIN_PASSWORD=change_me_before_prod

# --- Frontend ---
# Baked into the client JS bundle at `docker compose build` time (NEXT_PUBLIC_*
# vars are compile-time in Next.js) — changing this value requires rebuilding
# the frontend image (`docker compose build frontend`), a plain restart will
# NOT pick up a new value in the prod stack.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
