# Production environment for `docker compose -f docker-compose.prod.yml`.
# Copy to `.env` ON THE SERVER and fill in real values. Never commit the
# filled-in copy — it holds the database password, the JWT signing key and the
# admin password.
#
# This is separate from `.env.example`, which drives the local development
# stack and builds images instead of pulling them.

# --- Where images come from -------------------------------------------------
# GHCR requires a lowercase owner, hence `mor8t` rather than `MOR8T`.
REGISTRY=ghcr.io/mor8t
# Which build to run. CI also pushes a git-SHA tag, so pinning to one of those
# is how you roll back: set it here and `docker compose up -d`.
IMAGE_TAG=latest

# --- Public origin ----------------------------------------------------------
# Used for two things: the absolute URL browser <img> tags point at for
# admin-uploaded photos, and the backend's CORS allow-list. Read at runtime, so
# changing it to https://roller.tj later is an edit here plus a restart — no
# rebuild. Must have no trailing slash.
PUBLIC_ORIGIN=https://193.233.103.132

# --- nginx / TLS ----------------------------------------------------------
# Substituted into nginx/templates/roller.conf.template at container start.
# Defaults (below) serve any hostname with the self-signed certificate, which
# is the pre-domain arrangement.
#
# After Let's Encrypt has issued for the real domain, switch all three and
# restart nginx — no file on the server needs editing:
#
#   NGINX_SITE_SERVER_NAME=roller.tj www.roller.tj
#   NGINX_SITE_SSL_CERT=/etc/letsencrypt/live/roller.tj/fullchain.pem
#   NGINX_SITE_SSL_KEY=/etc/letsencrypt/live/roller.tj/privkey.pem
NGINX_SITE_SERVER_NAME=_
NGINX_SITE_SSL_CERT=/etc/nginx/certs/selfsigned.crt
NGINX_SITE_SSL_KEY=/etc/nginx/certs/selfsigned.key

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=roller
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
POSTGRES_DB=roller

# --- Backend ----------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_HOURS=8

# --- Initial admin ----------------------------------------------------------
# Seeded once at first backend start if this username doesn't exist yet; there
# is no /register endpoint, so this is the only way in. Change the password
# before the site is reachable by anyone else.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@roller.tj
INITIAL_ADMIN_PASSWORD=CHANGE_ME_strong_password
BACKEND_API_URL=https://1.1.1.1