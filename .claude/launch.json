{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 3031
    },
    {
      "name": "frontend-dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd frontend && npx next dev"],
      "autoPort": true
    },
    {
      "name": "backend",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd backend && venv/bin/uvicorn app.main:app --reload"],
      "port": 8000
    }
  ]
}
